# ============ 华住会自动签到 配置示例 ============
# 复制为 config.env 后按需修改。环境变量(如 docker-compose 里设置的)优先级高于此文件。
# 源码运行时, checkin.py 会自动读取同目录的 config.env。

# adb 可执行文件路径 (容器内/已装 adb 时保持 adb 即可)
ADB_PATH=adb

# 目标安卓设备的 adb 网络地址 (ip:port)。设置后脚本会先 adb connect。
# 例如: 局域网内手机执行过 `adb tcpip 5555` 后 -> 192.168.1.50:5555
#      同机 redroid 容器 -> 127.0.0.1:5555
ADB_HOST=192.168.1.50:5555

# 若通过 USB 或已有多设备, 用序列号精确指定 (与 ADB_HOST 二选一)
# ADB_SERIAL=

# 是否用 root 执行模拟点击。标准 AOSP/redroid 填 0; MIUI 等拦截模拟点击的填 1(需 root)。
USE_SU=0

# 常驻(--loop)模式每天执行时间, 24 小时制 HH:MM
RUN_AT=09:05

# ---- 点击坐标 ----
# 优先使用绝对坐标 x,y (针对你设备分辨率, 用 --calibrate 读取)。
# 若留空, 则用下面的比例(占屏宽/高 0~1)自动换算, 便于跨分辨率。
# TILE_XY=150,1944      # 首页"签到·福利领取"磁贴中心
# BUTTON_XY=540,1986    # 签到页红色"签到"按钮中心
TILE_FRAC=0.14,0.81
BUTTON_FRAC=0.50,0.83

# 可选: 若设备走了代理会弹"网络代理"提示, 填其"继续使用"坐标可自动点掉 (一般不需要)
# CONTINUE_XY=750,1314

# ---- PushPlus 微信推送 (可选) ----
# 在 https://www.pushplus.plus 获取 token, 填入后每次签到结果会推送到微信
PUSHPLUS_TOKEN=
# 可选: 群组编码(一对多推送时用), 单人可留空
PUSHPLUS_TOPIC=
# 推送时机: all=每次都推 / fail=仅失败推 / success=仅成功推
NOTIFY_ON=all

# 调试: 1 输出更多日志
DEBUG=0
