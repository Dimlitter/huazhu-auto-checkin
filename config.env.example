# ============ 华住会自动签到 配置示例 ============
# 复制为 config.env 后填写。环境变量(如 docker-compose 里设置的)优先级高于此文件。

# 【必填】userToken —— 华住会登录令牌。获取方法见 README「如何获取 userToken」。
# 多账号用 & 或换行分隔, 例如: HZ_TOKEN=token1&token2
HZ_TOKEN=

# 可选: token 持久化文件。设置后优先从此文件读取, 并在服务器下发新 token 时自动保存(滑动续期)。
# HZ_TOKEN_FILE=./data/token.txt

# --loop 常驻模式每天签到时间 (24 小时制 HH:MM)
RUN_AT=09:05

# 触发后随机延迟 0~此值(秒)再签到, 错峰避免 429 高峰限流 (默认 1800=30分钟; 设 0 关闭)
RANDOM_DELAY=1800
# 遇到 429/5xx/网络异常时的额外重试次数与基础间隔(秒, 按次线性递增)
RETRY_TIMES=3
RETRY_DELAY=60

# ---- PushPlus 微信推送 (可选) ----
# https://www.pushplus.plus 获取 token, 填了即在签到后推送结果(尤其 token 过期会第一时间提醒)
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
# 推送时机: all=每次 / fail=仅失败 / success=仅成功
NOTIFY_ON=all

# 调试: 1 输出更多日志
DEBUG=0
